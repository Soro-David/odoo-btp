# ==============================================================================
# BTP Manager - Environnement Docker
# ==============================================================================

# Nom du projet Docker Compose (préfixe des conteneurs, réseaux et volumes)
COMPOSE_PROJECT_NAME=btp_manager

# Versions des images Docker officielles
ODOO_IMAGE_TAG=17.0
POSTGRES_IMAGE_TAG=16

# Configuration PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_btp_secret_pwd_2026

# Configuration Odoo pour la connexion à PostgreSQL
HOST=db
PORT=5432
USER=odoo
PASSWORD=odoo_btp_secret_pwd_2026

# Mot de passe Master Odoo (gestion des bases : création, sauvegarde, restauration)
ADMIN_PASSWORD=admin_master_btp_pwd_2026

# Ports exposés sur la machine hôte
ODOO_PORT=8069
ODOO_CHAT_PORT=8072
